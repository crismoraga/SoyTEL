{
  "name": "soytel-app",
  "version": "3.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchman=false",
    "test:ci": "jest --watchman=false --runInBand",
    "smoke:brokers": "jest --watchman=false --runInBand --testMatch \"<rootDir>/tests/live/**/*.live.ts\"",
    "lint": "expo lint",
    "design:export": "node scripts/export-design.js",
    "design:system": "node scripts/build-design-system.js",
    "brand:kit": "node scripts/build-brand-kit.js",
    "build:web": "node scripts/build-web.js",
    "serve:web": "node scripts/serve-web.js",
    "csp:check": "node scripts/csp.js --check",
    "csp:write": "node scripts/csp.js --write",
    "e2e:web": "node scripts/e2e-web.js",
    "deploy:web": "node scripts/deploy-web.js",
    "android:release": "node scripts/build-android.js",
    "android:test-apk": "node scripts/build-android.js --debug-signing",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "db:migrate": "node scripts/db-migrate.js",
    "check": "npm run typecheck && npm run typecheck:api && npm run lint && npm run test:ci",
    "verify:web": "npm run check && npm run build:web",
    "fonts:web": "python scripts/build-web-fonts.py"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@neondatabase/serverless": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-refresh": "^0.19.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@electric-sql/pglite": "^0.5.8",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.4",
    "@types/ws": "^8.18.2",
    "aedes": "^1.2.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "puppeteer-core": "^25.12.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vercel": "62.7.0",
    "ws": "^8.22.0"
  }
}
